APP_ENV=development
MONGO_URL=mongodb+srv://username:password@cluster.mongodb.net/lifetracker?retryWrites=true&w=majority
DB_NAME=lifetracker
SECRET_KEY=change-this-to-a-secure-random-string-in-production
# Optional production edge-to-origin authentication. Keep this value server-side.
EDGE_ORIGIN_SECRET=replace-with-a-long-random-origin-secret
# Registration defaults to enabled locally and disabled on Railway/production.
# Set explicitly in production only when you intend to accept new public users.
# PUBLIC_REGISTRATION_ENABLED=false

# Gmail SMTP Configuration
GMAIL_EMAIL=your_gmail_email_here
GMAIL_APP_PASSWORD=your_gmail_app_password_here

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
FRONTEND_URL=http://localhost:3000
# Production callback registered in Google Cloud:
# GOOGLE_REDIRECT_URI=https://api.fintrack.olaifa.dev/api/auth/google/callback
# Comma-separated exact browser origins. Never use * with credentialed requests.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Plaid Configuration
PLAID_CLIENT_ID=your_plaid_client_id_here
PLAID_SECRET=your_plaid_secret_here
PLAID_ENV=sandbox
PLAID_PRODUCTS=transactions
PLAID_COUNTRY_CODES=CA
PLAID_CLIENT_NAME=LifeTracker
ANALYTICS_BASE_CURRENCY=CAD
# Initial transaction history to request (1-730 days). Cannot be increased after an Item is linked.
PLAID_TRANSACTION_DAYS_REQUESTED=730
# Optional paid/add-on product. Enable only after Plaid grants Recurring Transactions access.
PLAID_RECURRING_ENABLED=false
# Generate once with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PLAID_TOKEN_ENCRYPTION_KEY=replace_with_a_stable_fernet_key
# Optional for OAuth institutions and webhook-driven sync:
# PLAID_REDIRECT_URI=https://your-app-url.com
# PLAID_WEBHOOK_URL=https://your-backend-url.com/api/plaid/webhook

# Claude powers optional categorization and insight features.
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Optional Haiku model for the production recurring-candidate review. Larger
# models are reserved for offline adversarial evaluation and are rejected here.
ANTHROPIC_SUBSCRIPTION_REVIEW_MODEL=claude-haiku-4-5-20251001
